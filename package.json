{
  "name": "agentmonitoring",
  "private": true,
  "version": "1.5.1",
  "type": "module",
  "description": "Central record house where AI agents document their own work for humans.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "node scripts/bundle-cli.mjs && tauri build --config src-tauri/tauri.release.conf.json",
    "release": "node scripts/release.mjs",
    "screenshot": "node scripts/screenshot.mjs",
    "smoke": "node scripts/markdown-smoke.mjs",
    "check:clipping": "node scripts/check-clipping.mjs --locale ko && node scripts/check-clipping.mjs --locale en",
    "capture-refs": "node scripts/capture-refs.mjs",
    "progress": "node scripts/build-progress.mjs",
    "check:keys": "node scripts/check-keys.mjs",
    "check:i18n": "node scripts/check-i18n.mjs --locale ko && node scripts/check-i18n.mjs --locale en",
    "check:locale": "node scripts/check-locale-race.mjs",
    "check:errors": "node scripts/check-errors.mjs",
    "check:urlstate": "node scripts/check-urlstate.mjs",
    "check:counts": "node scripts/check-counts.mjs",
    "check:live": "node scripts/check-live.mjs",
    "check:projects": "node scripts/check-projects.mjs",
    "check:instructions": "node scripts/check-instructions.mjs",
    "check:mcp": "npm --prefix mcp test",
    "check:humanstyle": "node scripts/check-humanstyle-drift.mjs",
    "check:scenes": "node scripts/check-scenes.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@tauri-apps/api": "^2.9.0",
    "pretendard": "^1.3.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.9.4",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "playwright": "^1.56.1",
    "typescript": "^5.9.3",
    "vite": "^5.4.20"
  }
}

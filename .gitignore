# Build output and dependencies
node_modules/
dist/
target/
.vite/
src-tauri/gen/
# The `agentmon` binary staged for bundle.externalBin — a build artifact with a machine's
# target triple in its name, produced by scripts/bundle-cli.mjs.
src-tauri/binaries/

# Logs, OS litter, secrets
*.log
.DS_Store
Thumbs.db
.env
.env.local

# Scratch. Critics and builders drive the app with throwaway scripts and shoot tens of
# megabytes of evidence for a single round (SHOT_OUT=progress/critic-*); none of it is the
# product. Curated evidence goes in progress/<piece>/ and is committed on purpose.
progress/critic-*/
.critic-tmp/
.tmp-probe/
scripts/critic-*
scripts/.crit-*
